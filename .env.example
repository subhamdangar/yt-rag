
# Get a Gemini API key: https://aistudio.google.com/apikey
# Alternatively, get a Groq API key: https://console.groq.com/keys

# Configure at least one provider.
GEMINI_API_KEY=
GROQ_API_KEY=


# ====================================================================
# 2. YouTube Authentication (HIGHLY RECOMMENDED to avoid bot blocks)
# ====================================================================
# Export cookies.txt from your browser using the
# "Get cookies.txt LOCALLY" browser extension.
#
# Set this to the absolute path of your cookies.txt file.
# Windows example:
# YTRAG_COOKIES_FILE=C:\Users\YOUR_USERNAME\Desktop\ytscraper\cookies.txt
#
# Linux/macOS example:
# YTRAG_COOKIES_FILE=/path/to/ytscraper/cookies.txt
#
# Keep cookies.txt private. Never commit it to GitHub.
YTRAG_COOKIES_FILE=


# ====================================================================
# 3. Whisper Settings (GPU-Optimized Configuration)
# ====================================================================
# Model options depend on your hardware and installed CTranslate2 version.
# large-v3 offers high accuracy but requires substantial VRAM.
# large-v3-turbo can be faster and may use less VRAM.
YTRAG_WHISPER_MODEL=large-v3

# Use "cuda" for a compatible NVIDIA GPU; use "cpu" if CUDA is unavailable.
YTRAG_WHISPER_DEVICE=cuda

# Precision setting; compatibility depends on your GPU and runtime.
YTRAG_WHISPER_COMPUTE=int8_float16

# Lower this if you encounter GPU out-of-memory errors.
YTRAG_WHISPER_BATCH=4

# Language code, e.g. "en" for English.
YTRAG_WHISPER_LANG=en


# ====================================================================
# 4. Vector Database (Qdrant)
# ====================================================================
# Leave these blank to use local Qdrant storage, provided the application
# is configured to use its local storage path.
# A Qdrant account or Docker is not required for local storage.
#
# For a remote Qdrant instance, configure the URL and API key.
QDRANT_URL=
QDRANT_API_KEY=


# ====================================================================
# 5. Embedding Model
# ====================================================================
# all-MiniLM-L6-v2 is a lightweight sentence-transformer model.
# The model files are downloaded when first needed.
YTRAG_EMBED_MODEL=all-MiniLM-L6-v2


# ====================================================================
# 6. LLM Model Configuration
# ====================================================================
YTRAG_GEMINI_MODEL=gemini-3.8-flash
YTRAG_GROQ_MODEL=qwen/qwen3.8-27b


# ====================================================================
# 7. Search Configuration
# ====================================================================
# Qdrant collection used by the application.
YTRAG_COLLECTION=my_lectures

# Number of relevant results to retrieve.
YTRAG_TOP_K=4